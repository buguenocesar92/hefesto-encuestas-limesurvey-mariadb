# Referencia de variables. Copiar a .env y reemplazar los marcadores.
# NO usar este archivo como credenciales.

# --- Prefijo de volumen -------------------------------------------------
# Determina los nombres reales de los volumenes db, upload y config.
VOLUME_PREFIX=hefesto-encuestas

# --- Dominio publico ----------------------------------------------------
# Debe incluir el esquema https en el uso real.
SURVEY_HOST=encuestas.tudominio.cl

# --- Administrador inicial ----------------------------------------------
# La clave se usa SOLO en compose.bootstrap.yaml (alta inicial).
ADMIN_EMAIL=admin@tudominio.cl
ADMIN_PASSWORD=GENERAR_CON_OPENSSL_RAND_BASE64_32

# --- Claves de MariaDB --------------------------------------------------
DB_PASSWORD=GENERAR_CON_OPENSSL_RAND_BASE64_32
DB_ROOT_PASSWORD=GENERAR_CON_OPENSSL_RAND_BASE64_32

# --- Tag de imagen ------------------------------------------------------
# Debe coincidir con la version fijada en Dockerfile (7.5.1-261007).
IMAGE_TAG=7.5.1-261007
